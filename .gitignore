venv/
.venv/
env/

# Variables de entorno (secretos, nunca se sube)
.env
.env.*
!.env.example

# Cachés y compilados de Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Archivos del sistema operativo y del editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs
*.log

# Trazas, aprobaciones e informes simulados del agente (bloques 21 a 23)
output/agente/

# Índices, consultas y mediciones locales del RAG (bloques 24 a 28)
vectorstore/
output/rag/

# Mediciones y documentos base locales de la personalización (bloques 29 y 30)
output/personalizacion/

# Eventos locales, aprobaciones pendientes y decisiones (bloques 31 y 32)
output/observabilidad/
output/gobernanza/

# Paquetes locales de entrega; el código y las evidencias se versionan por separado
output/entrega-bloques-*.zip
