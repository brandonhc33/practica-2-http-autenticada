# Copia este archivo a .env y configura la clave de Gemini y el token de tu API.
# Las credenciales reales solo van en .env; ese archivo no se sube a Git.

# Agente y modelo habilitados (ejemplos comentados):
# AGENTE=gemini
# MODELO=flash-lite
# Alternativas comentadas:
# MODELO=flash
# MODELO=flash-3-8
# Catálogo: flash-lite -> gemini-3.5-flash-lite; flash -> gemini-3.6-flash;
# flash-3-8 -> gemini-3.8-flash.
# Actualmente se envían como agente/modelo en el JSON de la solicitud.
# El código todavía no lee AGENTE ni MODELO desde .env.

# Credencial del agente Gemini.
GEMINI_API_KEY=

# Token propio para proteger los endpoints de Python, sin el prefijo "Bearer ".
# Genera uno con: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
API_BEARER_TOKEN=

# Opcional: pesos chilenos por 1 USD, con punto decimal (por ejemplo, 950.50).
# Si se deja vacío, se consulta el dólar observado en https://indicadores.cl/api/v1/dolar.json.
USD_CLP=

# Evaluador: --modelos usa los identificadores del proveedor, no los alias:
# gemini-3.5-flash-lite, gemini-3.6-flash y gemini-3.8-flash.
# Para consultar el inventario de la cuenta:
#   uv run python -m src.comparar_modelos --listar-modelos
# Resultados y modelos propuestos para el RAG: README.md y docs/decision-arquitectura.md.
