{
  "info": {
    "name": "Bloque 4 - Primera petición autenticada",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "GEMINI_API_KEY", "value": "", "type": "string" },
    { "key": "GEMINI_MODEL", "value": "gemini-3.5-flash-lite", "type": "string" }
  ],
  "item": [
    {
      "name": "Consultar Gemini",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-goog-api-key", "value": "{{GEMINI_API_KEY}}" }
        ],
        "url": "https://generativelanguage.googleapis.com/v1beta/models/{{GEMINI_MODEL}}:generateContent",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"contents\": [\n    {\n      \"parts\": [\n        { \"text\": \"Hola, confirma en una frase que puedes responder esta consulta.\" }\n      ]\n    }\n  ]\n}",
          "options": { "raw": { "language": "json" } }
        }
      }
    }
  ]
}
