{
  "info": {
    "name": "Bloque 4 - Primera petición autenticada",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "GEMINI_API_KEY", "value": "", "type": "string" },
    { "key": "GEMINI_MODEL", "value": "gemini-3.5-flash-lite", "type": "string" }
  ],
  "item": [
    {
      "name": "Consultar Gemini",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{GEMINI_API_KEY}}", "type": "string" }
          ]
        },
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "https://generativelanguage.googleapis.com/v1beta/openai/chat/completions",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"{{GEMINI_MODEL}}\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Hola, ¿puedes confirmar que esta conexión funciona?\"\n    }\n  ]\n}",
          "options": { "raw": { "language": "json" } }
        }
      }
    }
  ]
}
