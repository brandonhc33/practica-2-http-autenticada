{
  "info": {
    "name": "Práctica 2 - API Python con Bearer token",
    "description": "Todas las respuestas usan error (booleano), codigo (estado HTTP), mensaje y detalles. Una consulta exitosa incluye detalles.respuesta, detalles.uso y detalles.costo_estimado con bloques usd y clp, tipo de cambio y tarifas por millón. Los importes son textos decimales con símbolo de moneda y sin exponentes. Los errores por campo aparecen en detalles.validaciones como campo y errores (array de strings).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('La respuesta usa el contrato común', function () {",
          "  const cuerpo = pm.response.json();",
          "  pm.expect(cuerpo).to.have.all.keys('error', 'codigo', 'mensaje', 'detalles');",
          "  pm.expect(cuerpo.error).to.be.a('boolean');",
          "  pm.expect(cuerpo.codigo).to.eql(pm.response.code);",
          "  pm.expect(cuerpo.error).to.eql(pm.response.code >= 400);",
          "  pm.expect(cuerpo.mensaje).to.be.a('string').and.not.empty;",
          "  pm.expect(cuerpo.detalles).to.be.an('object');",
          "  if (pm.response.code === 422) {",
          "    pm.expect(cuerpo.detalles.validaciones).to.be.an('array').and.not.empty;",
          "    cuerpo.detalles.validaciones.forEach(function (validacion) {",
          "      pm.expect(validacion).to.have.all.keys('campo', 'errores');",
          "      pm.expect(validacion.campo).to.be.a('string');",
          "      pm.expect(validacion.errores).to.be.an('array').and.not.empty;",
          "      validacion.errores.forEach(function (error) {",
          "        pm.expect(error).to.be.a('string').and.not.empty;",
          "      });",
          "    });",
          "  }",
          "});"
        ]
      }
    }
  ],
  "variable": [
    { "key": "BASE_URL", "value": "http://127.0.0.1:8000", "type": "string" },
    { "key": "AGENTE", "value": "gemini", "type": "string" },
    { "key": "MODELO", "value": "flash-lite", "type": "string" },
    { "key": "API_BEARER_TOKEN", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Estado de la API",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{API_BEARER_TOKEN}}", "type": "string" }
          ]
        },
        "method": "GET",
        "header": [],
        "url": "{{BASE_URL}}/health"
      }
    },
    {
      "name": "Consultar desde la API Python",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  pm.test('La consulta incluye texto, tokens y costo estimado', function () {",
              "    const detalles = pm.response.json().detalles;",
              "    pm.expect(detalles).to.have.all.keys('respuesta', 'uso', 'costo_estimado');",
              "    pm.expect(detalles.respuesta).to.be.a('string').and.not.empty;",
              "    if (detalles.uso !== null) {",
              "      pm.expect(detalles.uso.total).to.eql(detalles.uso.entrada + detalles.uso.salida);",
              "      pm.expect(detalles.uso.entrada_cache).to.be.within(0, detalles.uso.entrada);",
              "    }",
              "    if (detalles.costo_estimado !== null) {",
              "      const costo = detalles.costo_estimado;",
              "      pm.expect(detalles.uso).to.be.an('object');",
              "      ['usd', 'clp'].forEach(function (moneda) {",
              "        const importes = costo[moneda];",
              "        if (importes === null) return;",
              "        pm.expect(importes.moneda).to.eql(moneda.toUpperCase());",
              "        const prefijo = moneda === 'usd' ? 'US$ ' : '$ ';",
              "        ['entrada', 'salida', 'total'].forEach(function (campo) {",
              "          pm.expect(importes[campo]).to.be.a('string');",
              "          pm.expect(importes[campo].startsWith(prefijo)).to.eql(true);",
              "          pm.expect(importes[campo].slice(prefijo.length)).to.match(/^[0-9]+[.][0-9]{2,}$/);",
              "        });",
              "        const tarifas = costo['tarifas_por_millon_' + moneda];",
              "        pm.expect(tarifas).to.have.all.keys('entrada', 'entrada_cache', 'salida');",
              "        ['entrada', 'entrada_cache', 'salida'].forEach(function (campo) {",
              "          pm.expect(tarifas[campo]).to.be.a('string');",
              "          pm.expect(tarifas[campo].startsWith(prefijo)).to.eql(true);",
              "          pm.expect(tarifas[campo].slice(prefijo.length)).to.match(/^[0-9]+[.][0-9]{2,}$/);",
              "        });",
              "      });",
              "      if (costo.clp !== null) {",
              "        pm.expect(costo.tipo_cambio.clp_por_usd).to.match(/^[0-9]+[.][0-9]{2,}$/);",
              "        pm.expect(costo.tipo_cambio.fuente).to.be.a('string').and.not.empty;",
              "        pm.expect(costo.aviso_clp).to.eql(null);",
              "      } else {",
              "        pm.expect(costo.tarifas_por_millon_clp).to.eql(null);",
              "        pm.expect(costo.aviso_clp).to.be.a('string').and.not.empty;",
              "      }",
              "    }",
              "  });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "description": "Devuelve texto, uso real de tokens y costos estimados en USD y CLP con símbolo de moneda y todos los decimales significativos. Incluye fecha, fuente y valor del tipo de cambio. Si falla la conversión, conserva USD y devuelve aviso_clp; uso o costo pueden ser null si faltan metadatos válidos o tarifas para el modelo.",
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{API_BEARER_TOKEN}}", "type": "string" }
          ]
        },
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{BASE_URL}}/consultar",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"agente\": \"{{AGENTE}}\",\n  \"modelo\": \"{{MODELO}}\",\n  \"mensaje\": \"Hola, ¿puedes confirmar que esta conexión funciona?\"\n}",
          "options": { "raw": { "language": "json" } }
        }
      }
    },
    {
      "name": "Validación - campos faltantes",
      "request": {
        "description": "Devuelve HTTP 422: faltan agente, modelo y mensaje; pregunta no es un campo permitido.",
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{API_BEARER_TOKEN}}", "type": "string" }
          ]
        },
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{BASE_URL}}/consultar",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pregunta\": \"Hola, ¿en qué puedes ayudarme?\"\n}",
          "options": { "raw": { "language": "json" } }
        }
      }
    },
    {
      "name": "Validación - valores inválidos",
      "request": {
        "description": "Devuelve HTTP 422: agente debe estar en minúsculas, modelo debe ser texto y mensaje no puede estar vacío.",
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{API_BEARER_TOKEN}}", "type": "string" }
          ]
        },
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{BASE_URL}}/consultar",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"agente\": \"Gemini\",\n  \"modelo\": 42,\n  \"mensaje\": \"   \"\n}",
          "options": { "raw": { "language": "json" } }
        }
      }
    },
    {
      "name": "Autenticación - sin token",
      "request": {
        "description": "Devuelve HTTP 401 con el contrato común y la indicación del encabezado requerido.",
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [],
        "url": "{{BASE_URL}}/health"
      }
    }
  ]
}
