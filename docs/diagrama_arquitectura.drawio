        <mxCell id="v45" value="Práctica 2 · Consulta HTTP autenticada a Gemini · Flujo de POST /consultar" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=25;fontColor=#51657c;fontStyle=0;" vertex="1" parent="1">
