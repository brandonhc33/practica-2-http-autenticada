        </mxCell>
        <mxCell id="v46" value="Código real del repositorio · Bloque 8 · 19 de octubre de 2026" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=21;fontColor=#51657c;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="150" width="864.3000000000001" height="36.35" />
