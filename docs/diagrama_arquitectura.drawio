        <mxCell id="v44" value="Arquitectura de la miniaplicación" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=46;fontColor=#152d47;fontStyle=1;" vertex="1" parent="1">
