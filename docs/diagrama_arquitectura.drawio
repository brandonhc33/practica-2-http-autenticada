        <mxCell id="v48" value="consultar_gemini(modelo, mensaje)" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans Mono;fontSize=23;fontColor=#2463a7;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="560" y="918" width="511.35" height="39.05" />
        </mxCell>
        <mxCell id="v49" value="consultar_gemini_raw(modelo, mensaje)" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans Mono;fontSize=22;fontColor=#2463a7;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="580" y="993" width="547.1" height="37.7" />
        </mxCell>
        <mxCell id="v50" value="try: petición HTTP + estado + respuesta.json()" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=21;fontColor=#a56b15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="590" y="1260" width="645.9" height="36.35" />
        </mxCell>
        <mxCell id="v51" value="Usuario · Yaak / Postman" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=25;fontColor=#2463a7;fontStyle=1;" vertex="1" parent="node-usuario">
          <mxGeometry as="geometry" x="24" y="20" width="752" height="41.75" />
        </mxCell>
        <mxCell id="v52" value="Escribe una pregunta en el campo mensaje." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=22;fontColor=#152d47;fontStyle=0;" vertex="1" parent="node-usuario">
          <mxGeometry as="geometry" x="24" y="62" width="752" height="37.7" />
        </mxCell>
        <mxCell id="v53" value="POST /consultar · src/api.py" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=25;fontColor=#2463a7;fontStyle=1;" vertex="1" parent="node-api">
          <mxGeometry as="geometry" x="24" y="20" width="752" height="41.75" />
        </mxCell>
        <mxCell id="v54" value="validar_bearer() autentica; Consulta valida el JSON.&#10;consultar() llama a ejecutar_consulta()." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=22;fontColor=#152d47;fontStyle=0;" vertex="1" parent="node-api">
          <mxGeometry as="geometry" x="24" y="62" width="752" height="67.4" />
        </mxCell>
        <mxCell id="v55" value="consultar_agente(consulta)" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=24;fontColor=#152d47;fontStyle=1;" vertex="1" parent="node-agente">
          <mxGeometry as="geometry" x="24" y="20" width="752" height="40.400000000000006" />
        </mxCell>
        <mxCell id="v56" value="obtener_modelo_configurado(): flash-lite&#10;se resuelve a gemini-3.5-flash-lite." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=21;fontColor=#152d47;fontStyle=0;" vertex="1" parent="node-agente">
          <mxGeometry as="geometry" x="24" y="62" width="752" height="64.7" />
        </mxCell>
        <mxCell id="v57" value="1 · Armar la petición" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=25;fontColor=#2463a7;fontStyle=1;" vertex="1" parent="node-armar">
          <mxGeometry as="geometry" x="24" y="20" width="752" height="41.75" />
        </mxCell>
        <mxCell id="v58" value="En consultar_gemini_raw(): os.getenv(&quot;GEMINI_API_KEY&quot;)&#10;headers: Content-Type + Authorization: Bearer &lt;clave&gt;&#10;cuerpo: {model, messages: [{role: &quot;user&quot;, content: mensaje}]}" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=20;fontColor=#152d47;fontStyle=0;" vertex="1" parent="node-armar">
          <mxGeometry as="geometry" x="24" y="62" width="752" height="89.0" />
        </mxCell>
        <mxCell id="v59" value="2 · Enviar y leer la respuesta HTTP" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=25;fontColor=#2463a7;fontStyle=1;" vertex="1" parent="node-enviar">
          <mxGeometry as="geometry" x="24" y="20" width="752" height="41.75" />
        </mxCell>
        <mxCell id="v60" value="En consultar_gemini_raw(): requests.post(ENDPOINT, ...)&#10;timeout=(10, 60); allow_redirects=False&#10;Si status_code != 200: raise ValueError; si no: .json()" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=20;fontColor=#152d47;fontStyle=0;" vertex="1" parent="node-enviar">
          <mxGeometry as="geometry" x="24" y="62" width="752" height="89.0" />
        </mxCell>
        <mxCell id="v61" value="3 · Extraer el texto generado" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=25;fontColor=#2463a7;fontStyle=1;" vertex="1" parent="node-texto">
          <mxGeometry as="geometry" x="24" y="20" width="752" height="41.75" />
        </mxCell>
        <mxCell id="v62" value="En consultar_gemini(): datos[&quot;choices&quot;][0][&quot;message&quot;][&quot;content&quot;]&#10;Valida que sea texto no vacío y aplica .strip().&#10;El texto se conserva para construir Resultado." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=20;fontColor=#152d47;fontStyle=0;" vertex="1" parent="node-texto">
          <mxGeometry as="geometry" x="24" y="62" width="752" height="89.0" />
        </mxCell>
        <mxCell id="v63" value="extraer_uso(datos.get(&quot;usage&quot;))" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=24;fontColor=#198271;fontStyle=1;" vertex="1" parent="node-uso">
          <mxGeometry as="geometry" x="24" y="20" width="752" height="40.400000000000006" />
        </mxCell>
        <mxCell id="v64" value="prompt_tokens, completion_tokens, total_tokens y cached_tokens&#10;UsoTokens: entrada, salida=total-entrada, total, entrada_cache&#10;try: UsoTokens.model_validate(); except ValidationError: None&#10;Si faltan datos o son incoherentes, devuelve uso=None." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=20;fontColor=#152d47;fontStyle=0;" vertex="1" parent="node-uso">
          <mxGeometry as="geometry" x="24" y="62" width="752" height="116.0" />
        </mxCell>
        <mxCell id="v65" value="calcular_costo_gemini(modelo, uso)" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=24;fontColor=#198271;fontStyle=1;" vertex="1" parent="node-costo">
          <mxGeometry as="geometry" x="24" y="20" width="752" height="40.400000000000006" />
        </mxCell>
        <mxCell id="v66" value="Después de recibir el JSON: usa tarifas de src/costos.py.&#10;USD = costo de entrada + costo de caché + costo de salida&#10;(cada consumo × su tarifa) / 1.000.000; cálculo con Decimal.&#10;try: obtener_tipo_cambio() + conversión a CLP&#10;except ValueError: conserva USD; clp=None y aviso_clp.&#10;Sin uso válido o sin tarifas: costo_estimado=None." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=20;fontColor=#152d47;fontStyle=0;" vertex="1" parent="node-costo">
          <mxGeometry as="geometry" x="24" y="62" width="752" height="170.0" />
        </mxCell>
        <mxCell id="v67" value="El usuario recibe HTTP 200 + JSON" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=25;fontColor=#2463a7;fontStyle=1;" vertex="1" parent="node-resultado">
          <mxGeometry as="geometry" x="24" y="20" width="752" height="41.75" />
        </mxCell>
        <mxCell id="v68" value="consultar_gemini() devuelve Resultado(respuesta, uso, costo_estimado).&#10;consultar() lo envuelve en RespuestaAPI:&#10;{error: false, codigo: 200, mensaje, detalles: Resultado}" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=20;fontColor=#152d47;fontStyle=0;" vertex="1" parent="node-resultado">
          <mxGeometry as="geometry" x="24" y="62" width="752" height="89.0" />
        </mxCell>
        <mxCell id="v69" value=".env · excluido de Git" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=24;fontColor=#152d47;fontStyle=1;" vertex="1" parent="node-env">
          <mxGeometry as="geometry" x="24" y="20" width="342" height="40.400000000000006" />
        </mxCell>
        <mxCell id="v70" value="API_BEARER_TOKEN&#10;GEMINI_API_KEY&#10;USD_CLP (opcional)" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=22;fontColor=#152d47;fontStyle=0;" vertex="1" parent="node-env">
          <mxGeometry as="geometry" x="24" y="62" width="342" height="97.10000000000001" />
        </mxCell>
        <mxCell id="v71" value="lifespan() ejecuta load_dotenv()&#10;al iniciar la API y carga el token.&#10;Nunca se dibujan valores reales." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=20;fontColor=#51657c;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="438" width="473.0" height="89.0" />
        </mxCell>
        <mxCell id="v72" value="Nombres del curso" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=24;fontColor=#152d47;fontStyle=1;" vertex="1" parent="node-equivalencias">
          <mxGeometry as="geometry" x="24" y="20" width="342" height="40.400000000000006" />
        </mxCell>
        <mxCell id="v73" value="armar_peticion y&#10;enviar_peticion corresponden&#10;a dos etapas de&#10;consultar_gemini_raw().&#10;&#10;extraer_texto corresponde&#10;a una etapa de&#10;consultar_gemini().&#10;&#10;No son funciones separadas&#10;en este proyecto." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=20;fontColor=#152d47;fontStyle=0;" vertex="1" parent="node-equivalencias">
          <mxGeometry as="geometry" x="24" y="62" width="342" height="305.0" />
        </mxCell>
        <mxCell id="v74" value="usageMetadata → usage" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=23;fontColor=#198271;fontStyle=1;" vertex="1" parent="node-metadatos">
          <mxGeometry as="geometry" x="24" y="20" width="342" height="39.05" />
        </mxCell>
        <mxCell id="v75" value="Este endpoint usa el formato&#10;compatible con OpenAI:&#10;el consumo llega en usage&#10;dentro del JSON de Gemini." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=20;fontColor=#152d47;fontStyle=0;" vertex="1" parent="node-metadatos">
          <mxGeometry as="geometry" x="24" y="62" width="342" height="116.0" />
        </mxCell>
        <mxCell id="v76" value="obtener_tipo_cambio()" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=22;fontColor=#152d47;fontStyle=1;" vertex="1" parent="node-cambio">
          <mxGeometry as="geometry" x="24" y="20" width="342" height="37.7" />
        </mxCell>
        <mxCell id="v77" value="1. USD_CLP del entorno, o&#10;2. consultar_dolar():&#10;GET indicadores.cl/api/v1/&#10;dolar.json; caché de 1 hora.&#10;&#10;Devuelve TipoCambio o&#10;lanza ValueError si falla." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=20;fontColor=#152d47;fontStyle=0;" vertex="1" parent="node-cambio">
          <mxGeometry as="geometry" x="24" y="62" width="342" height="197.0" />
        </mxCell>
        <mxCell id="v78" value="La consulta del dólar es pública.&#10;Solo transporta la tasa y su fecha.&#10;La pregunta y las claves no viajan&#10;a este servicio." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=20;fontColor=#51657c;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="2415" width="473.0" height="116.0" />
        </mxCell>
        <mxCell id="v79" value="except en ejecutar_consulta()" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=25;fontColor=#bf4050;fontStyle=1;" vertex="1" parent="node-mapeo">
          <mxGeometry as="geometry" x="24" y="20" width="642" height="41.75" />
        </mxCell>
        <mxCell id="v80" value="AgenteNoConfigurado → ErrorAPI(503)&#10;ValueError → ErrorAPI(502)&#10;registrar_manejadores() serializa el error en JSON." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=22;fontColor=#152d47;fontStyle=0;" vertex="1" parent="node-mapeo">
          <mxGeometry as="geometry" x="24" y="62" width="642" height="97.10000000000001" />
        </mxCell>
        <mxCell id="v81" value="except en consultar_gemini_raw()" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=24;fontColor=#bf4050;fontStyle=1;" vertex="1" parent="node-http_errores">
          <mxGeometry as="geometry" x="24" y="20" width="642" height="40.400000000000006" />
        </mxCell>
        <mxCell id="v82" value="requests.exceptions.JSONDecodeError → ValueError&#10;requests.exceptions.Timeout → ValueError&#10;requests.exceptions.RequestException → ValueError" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=21;fontColor=#152d47;fontStyle=0;" vertex="1" parent="node-http_errores">
          <mxGeometry as="geometry" x="24" y="62" width="642" height="93.05000000000001" />
        </mxCell>
        <mxCell id="v83" value="Gemini · servicio externo" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=26;fontColor=#2463a7;fontStyle=1;" vertex="1" parent="node-gemini">
          <mxGeometry as="geometry" x="24" y="20" width="642" height="43.1" />
        </mxCell>
        <mxCell id="v84" value="https://generativelanguage.googleapis.com&#10;/v1beta/openai/chat/completions&#10;Recibe la clave Gemini en el encabezado Authorization.&#10;Devuelve choices + usage dentro del JSON." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=21;fontColor=#152d47;fontStyle=0;" vertex="1" parent="node-gemini">
          <mxGeometry as="geometry" x="24" y="62" width="642" height="121.4" />
        </mxCell>
        <mxCell id="v85" value="Validación de respuesta → ValueError" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=24;fontColor=#bf4050;fontStyle=1;" vertex="1" parent="node-forma">
          <mxGeometry as="geometry" x="24" y="20" width="642" height="40.400000000000006" />
        </mxCell>
        <mxCell id="v86" value="consultar_gemini_raw(): si datos no es dict.&#10;consultar_gemini(): si falta texto o está vacío.&#10;El ValueError se propaga a ejecutar_consulta()." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=21;fontColor=#152d47;fontStyle=0;" vertex="1" parent="node-forma">
          <mxGeometry as="geometry" x="24" y="62" width="642" height="93.05000000000001" />
        </mxCell>
        <mxCell id="v87" value="Errores recuperables" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=25;fontColor=#a56b15;fontStyle=1;" vertex="1" parent="node-recu">
          <mxGeometry as="geometry" x="24" y="20" width="642" height="41.75" />
        </mxCell>
        <mxCell id="v88" value="Consumo ausente / inválido: uso y costo quedan null.&#10;Falla del tipo de cambio: se mantienen texto y USD.&#10;No se convierte consumo desconocido en costo cero." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=21;fontColor=#152d47;fontStyle=0;" vertex="1" parent="node-recu">
          <mxGeometry as="geometry" x="24" y="62" width="642" height="93.05000000000001" />
        </mxCell>
        <mxCell id="v89" value="Errores de entrada y del servidor" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=25;fontColor=#bf4050;fontStyle=1;" vertex="1" parent="node-entradaerrores">
          <mxGeometry as="geometry" x="24" y="20" width="642" height="41.75" />
        </mxCell>
        <mxCell id="v90" value="validar_bearer(): token ausente / inválido → HTTP 401&#10;Consulta: datos inválidos → HTTP 422&#10;lifespan(): falta API_BEARER_TOKEN → no inicia&#10;Manejador global: excepción no prevista → HTTP 500" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=21;fontColor=#152d47;fontStyle=0;" vertex="1" parent="node-entradaerrores">
          <mxGeometry as="geometry" x="24" y="62" width="642" height="121.4" />
        </mxCell>
        <mxCell id="v91" value="Cómo leer el diagrama" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=27;fontColor=#152d47;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1610" y="2190" width="386.55" height="44.45" />
        </mxCell>
        <mxCell id="v92" value="Azul: pregunta, petición y respuesta.&#10;Punteado: configuración o alcance de una función / try.&#10;Rojo: error y propagación de excepciones.&#10;Verde: consumo y cálculo del costo.&#10;&#10;Alcance: POST /consultar, con texto y costo.&#10;La ruta /consultar/raw devuelve el JSON sin calcular costos." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=21;fontColor=#51657c;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1610" y="2240" width="837.0" height="206.45000000000002" />
        </mxCell>
        <mxCell id="v93" value="Fuentes: src/api.py · src/agentes.py · src/agente_gemini.py · src/costos.py · src/tipo_cambio.py · src/esquemas.py" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontSize=20;fontColor=#51657c;fontStyle=0;" vertex="1" parent="1">
