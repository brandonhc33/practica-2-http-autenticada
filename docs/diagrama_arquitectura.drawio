        <mxCell id="v47" value="try de ejecutar_consulta(): return cliente(consulta)" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans Mono;fontSize=22;fontColor=#2463a7;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="535" y="647" width="761.6" height="37.7" />
